Windows Registry Editor Version 5.00

; ============================================================
; md-v 免安装文件关联脚本（当前用户 HKCU，无需管理员权限）
;
; 用法：
;   1. 把本文件中所有  C:\\Path\\To\\md-v.exe  替换为 md-v.exe
;      的实际完整路径（注意保持双反斜杠，可用编辑器"全部替换"）；
;   2. 保存后双击导入；
;   3. 效果：
;      - .md / .markdown：完整关联 —— 图标变为 md-v 图标，
;        双击默认用 md-v 打开，右键出现 "Open with md-v"；
;      - 其它文本后缀（.txt .json .xml .yaml .py .sh 等）：
;        只在右键菜单增加 "Open with md-v"，
;        不改变双击默认打开方式。
; 卸载：删除注册表项 HKCU\Software\Classes\.md、
;       HKCU\Software\Classes\.markdown、
;       HKCU\Software\Classes\md-v.md，以及
;       HKCU\Software\Classes\SystemFileAssociations\ 下
;       各后缀的 shell\Open with md-v 子键。
; ============================================================

; ---- .md / .markdown 完整关联 ----

[HKEY_CURRENT_USER\Software\Classes\.md]
@="md-v.md"

[HKEY_CURRENT_USER\Software\Classes\.markdown]
@="md-v.md"

[HKEY_CURRENT_USER\Software\Classes\md-v.md]
@="Markdown Document"

[HKEY_CURRENT_USER\Software\Classes\md-v.md\DefaultIcon]
@="C:\\Path\\To\\md-v.exe,0"

[HKEY_CURRENT_USER\Software\Classes\md-v.md\shell\Open with md-v]
@="Open with md-v"
"Icon"="C:\\Path\\To\\md-v.exe,0"

[HKEY_CURRENT_USER\Software\Classes\md-v.md\shell\Open with md-v\command]
@="\"C:\\Path\\To\\md-v.exe\" \"%1\""

; ---- 其它文本后缀：仅右键项，不动默认关联 ----

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.txt\shell\Open with md-v]
@="Open with md-v"
"Icon"="C:\\Path\\To\\md-v.exe,0"
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.txt\shell\Open with md-v\command]
@="\"C:\\Path\\To\\md-v.exe\" \"%1\""

