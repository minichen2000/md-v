{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-v",
  "version": "0.6.0",
  "identifier": "com.minic.mdv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "md-v",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer"
      },
      {
        "ext": ["txt", "log", "json", "xml", "yaml", "yml", "toml", "ini", "conf", "sh", "py", "js", "ts", "html", "css", "sql", "rs", "c", "cpp", "h", "java", "php", "diff"],
        "name": "Text Document",
        "description": "Text Document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
